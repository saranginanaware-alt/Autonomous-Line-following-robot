#include <graphics.h>
#include <conio.h>
#include <dos.h>
#include <stdio.h>

void track(void)
{
    setcolor(WHITE);
    setlinestyle(SOLID_LINE, 0, THICK_WIDTH);

    /* Rectangular track: Q1 -> Q2 -> Q4 -> Q3 -> Q1 */
    line(90, 100, 550, 100);
    line(550, 100, 550, 370);
    line(550, 370, 90, 370);
    line(90, 370, 90, 100);

    setlinestyle(SOLID_LINE, 0, NORM_WIDTH);
    setcolor(YELLOW);
    outtextxy(100, 70, "QUADRANT 1");
    outtextxy(450, 70, "QUADRANT 2");
    outtextxy(450, 390, "QUADRANT 4");
    outtextxy(100, 390, "QUADRANT 3");

    setcolor(LIGHTCYAN);
    outtextxy(180, 20, "AUTONOMOUS LINE FOLLOWING ROBOT");
    outtextxy(180, 440, "Press any key to stop");
}

void robot(int x, int y, int step)
{
    int leg;

    if (step % 2 == 0)
        leg = 8;
    else
        leg = -8;

    /* Head */
    setcolor(LIGHTCYAN);
    setfillstyle(SOLID_FILL, LIGHTCYAN);
    fillellipse(x, y - 20, 12, 12);

    /* Eyes */
    setcolor(BLACK);
    putpixel(x - 4, y - 22, BLACK);
    putpixel(x + 4, y - 22, BLACK);

    /* Body */
    setcolor(WHITE);
    setfillstyle(SOLID_FILL, BLUE);
    bar(x - 12, y - 7, x + 12, y + 18);
    rectangle(x - 12, y - 7, x + 12, y + 18);

    /* Arms */
    setcolor(YELLOW);
    line(x - 12, y, x - 22, y + leg);
    line(x + 12, y, x + 22, y - leg);

    /* Legs and feet */
    setcolor(WHITE);
    line(x - 6, y + 18, x - 7 + leg, y + 38);
    line(x + 6, y + 18, x + 7 - leg, y + 38);
    line(x - 7 + leg, y + 38, x - 16 + leg, y + 38);
    line(x + 7 - leg, y + 38, x + 16 - leg, y + 38);
}

void moveRight(int startX, int endX, int y)
{
    int x, frame;

    for (x = startX, frame = 0; x <= endX; x += 5, frame++)
    {
        if (kbhit()) return;
        cleardevice();
        track();
        robot(x, y, frame);
        delay(45);
    }
}

void moveDown(int x, int startY, int endY)
{
    int y, frame;

    for (y = startY, frame = 0; y <= endY; y += 5, frame++)
    {
        if (kbhit()) return;
        cleardevice();
        track();
        robot(x, y, frame);
        delay(45);
    }
}

void moveLeft(int startX, int endX, int y)
{
    int x, frame;

    for (x = startX, frame = 0; x >= endX; x -= 5, frame++)
    {
        if (kbhit()) return;
        cleardevice();
        track();
        robot(x, y, frame);
        delay(45);
    }
}

void moveUp(int x, int startY, int endY)
{
    int y, frame;

    for (y = startY, frame = 0; y >= endY; y -= 5, frame++)
    {
        if (kbhit()) return;
        cleardevice();
        track();
        robot(x, y, frame);
        delay(45);
    }
}

int main(void)
{
    int gd, gm;

    gd = DETECT;
    gm = 0;

    /* Change to C:\\TC\\BGI if that is your BGI folder. */
    initgraph(&gd, &gm, "C:\\TURBOC3\\BGI");

    if (graphresult() != grOk)
    {
        printf("Cannot start graphics. Check the BGI folder path.");
        getch();
        return 1;
    }

    while (!kbhit())
    {
        /* Quadrant 1: top-left to Quadrant 2: top-right */
        moveRight(110, 530, 115);
        if (kbhit()) break;

        /* Quadrant 2: top-right to Quadrant 4: bottom-right */
        moveDown(530, 115, 325);
        if (kbhit()) break;

        /* Quadrant 4: bottom-right to Quadrant 3: bottom-left */
        moveLeft(530, 110, 325);
        if (kbhit()) break;

        /* Quadrant 3: bottom-left to Quadrant 1: top-left */
        moveUp(110, 325, 115);
    }

    if (kbhit())
        getch();

    closegraph();
    return 0;
}
